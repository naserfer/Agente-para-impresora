# ============================================
# CONFIGURACIÓN DEL AGENTE DE IMPRESIÓN
# ============================================

# ============================================
# SUPABASE (REQUERIDO para impresión automática)
# ============================================
SUPABASE_URL=https://zzyjmcjritfudginsvln.supabase.co
SUPABASE_ANON_KEY=tu-anon-key-aqui

# Tabla de pedidos a escuchar (por defecto: pedidos)
SUPABASE_ORDERS_TABLE=pedidos

# Habilitar listener de Supabase Realtime (true/false)
ENABLE_SUPABASE_LISTENER=true

# Escuchar INSERT en public.reprint_solicitud (reimpresión explícita cocina/factura)
# ENABLE_REPRINT_SOLICITUD=false

# Bloqueo global de impresión de facturas (incluye emisión automática, reprint y endpoints HTTP de factura)
# false = bloqueado (estado actual recomendado), true = habilitado
ENABLE_INVOICE_PRINTING=false

# Ticket cliente de bienvenida (sale después del ticket de cocina en flujo normal)
# true = habilitado, false = deshabilitado
ENABLE_CUSTOMER_WELCOME_TICKET=true
# Texto explicativo de equivalencia para el ticket cliente
# CUSTOMER_WELCOME_POINTS_EQ_TEXT=1 punto = 1 Gs

# Opcional: solo estos tenant_id (UUID separados por coma) si un mismo Supabase sirve varios locales
# AGENT_TENANT_IDS=10794121-1e82-4185-8966-c7d00ae1e82b

# Ventana de tiempo (minutos) desde pedidos.created_at: solo imprime automáticamente pedidos FACT
# creados dentro de esta ventana (evita backlog al conectar el agente). Si no definís la variable,
# el código usa 10 por defecto. Poné 0 para desactivar el límite.
# PRINT_ORDER_MAX_AGE_MINUTES=10

# Si usás anon y reprint no imprime: probá SERVICE ROLE solo en el agente (nunca en el browser)
# SUPABASE_SERVICE_ROLE_KEY=

# Ventana en minutos para polling de reprint_solicitud (default = POLLING_FACT_MINUTES o 15)
# POLLING_REPRINT_MINUTES=15

# Escuchar UPDATE en facturas (PATCH updated_at desde KaruBox para reimprimir fiscal)
# ENABLE_FACTURA_BUMP_LISTENER=false
# POLLING_FACTURA_BUMP_MINUTES=15

# ============================================
# SERVIDOR
# ============================================
PORT=3001
HOST=0.0.0.0

# true = no abre Express (POST /print desactivado); solo impresión vía Supabase Realtime
# DISABLE_HTTP_SERVER=true

# ============================================
# CORS (Orígenes permitidos)
# ============================================
# Separar múltiples orígenes con comas
ALLOWED_ORIGINS=https://lomiteria1-0.vercel.app,http://localhost:3000,http://localhost:5173

# ============================================
# IMPRESORA (Configuración por defecto)
# ============================================
DEFAULT_PRINTER_TYPE=usb
DEFAULT_PRINTER_IP=192.168.1.100
DEFAULT_PRINTER_PORT=9100

# Spool Windows SOLO fast-path (sin fallback legacy)
# Requiere impresora compartida en Windows (Shared=true y ShareName válido).
WINDOWS_SPOOL_FAST_PATH=true
# Opcional: forzar host UNC para fast-path (recomendado en PCs con COMPUTERNAME raro)
# WINDOWS_SPOOL_FAST_PATH_HOST=127.0.0.1
# Opcional: forzar ShareName si la detección automática falla
# WINDOWS_PRINTER_SHARE_NAME=EPSON_TM_T20III_Receipt
# Opcional: timeout de verificación Shared/ShareName (ms)
# WINDOWS_SHARE_CHECK_TIMEOUT_MS=5000

# Retries de ítems de cocina (emisión inicial). Default actual: 1 intento para minimizar latencia.
# KITCHEN_ITEMS_RETRY_ATTEMPTS=1
# KITCHEN_ITEMS_RETRY_DELAY_MS=250

# ============================================
# LOGS
# ============================================
LOG_LEVEL=info

# ============================================
# TÚNELES (Opcional - solo si necesitas acceso desde internet)
# ============================================
# AUTO_TUNNEL=false
# TUNNEL_TYPE=localtunnel
# TUNNEL_SUBDOMAIN=atlas-burger-print
